% Original outline icons; adjacent labels carry their scientific meaning.
\newcommand{\atlasicon}[1]{\tikz[baseline=-0.55ex,x=1.35ex,y=1.35ex,line width=0.45pt,draw=atlasblue,line cap=round,line join=round]{
  \useasboundingbox (0,-0.05) rectangle (1.1,1.05);
  \csname atlas@icon@#1\endcsname}}
\newcommand{\atlas@icon@data}{\draw (0.08,0.08) rectangle (1.02,0.93);\draw (0.08,0.64)--(1.02,0.64) (0.08,0.35)--(1.02,0.35) (0.42,0.08)--(0.42,0.93);}
\newcommand{\atlas@icon@document}{\draw (0.2,0.05)--(0.9,0.05)--(0.9,0.76)--(0.67,1)--(0.2,1)--cycle;\draw (0.67,1)--(0.67,0.76)--(0.9,0.76) (0.34,0.53)--(0.75,0.53) (0.34,0.32)--(0.75,0.32);}
\newcommand{\atlas@icon@link}{\draw[rounded corners=1pt,rotate around={35:(0.55,0.52)}] (0.05,0.3) rectangle (0.63,0.7);\draw[rounded corners=1pt,rotate around={35:(0.55,0.52)}] (0.5,0.3) rectangle (1.05,0.7);}
\newcommand{\atlas@icon@coin}{\draw (0.55,0.53) circle (0.46);\draw (0.39,0.26)--(0.39,0.8)--(0.62,0.8) arc (90:-90:0.13)--(0.39,0.54) (0.39,0.54)--(0.65,0.54) arc (90:-90:0.14)--(0.39,0.26);}
\newcommand{\atlas@icon@clock}{\draw (0.55,0.53) circle (0.46);\draw (0.55,0.83)--(0.55,0.53)--(0.8,0.38);}
\newcommand{\atlas@icon@compare}{\draw (0.08,0.17) rectangle (0.5,0.95);\draw (0.68,0.07) circle (0.27);\draw (0.88,0.01)--(1.08,-0.12) (0.18,0.71)--(0.4,0.71) (0.18,0.48)--(0.4,0.48);}
