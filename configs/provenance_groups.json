        "scripts/ingest_chainlink_evidence.py",
        "scripts/build_chainlink_evidence.py",
        "src/oracle_ledger/chainlink_evidence_build.py"
      ],
      "transformation": "Decode registered feed/Transfer logs; restrict reports to active proxy phases and reconcile LINK flow routes."
